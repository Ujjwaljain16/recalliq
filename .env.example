# Copy to .env and fill in. Values are validated at startup (src/config/env.ts and src/app/env.ts).
# `.env` is ignored by git. Never put real keys in this file.
# Only APP_MODE and DB_PATH matter for the database tooling and the tests; the rest is for running the application.

# --- Component set: exactly one, fixed for the life of the process; there is no automatic fallback between them ---
# scripted (default): canned demo answers, no search and no model.
# replay: the real pipeline over recorded fixtures. Needs APP_MODE=demo and REPLAY_FIXTURE.
# live: the real pipeline over Gemini and Exa. Needs APP_MODE=real, GEMINI_API_KEY, GEMINI_MODEL and EXA_API_KEY.
APP_COMPONENTS=scripted
# REPLAY_FIXTURE=tests/fixtures/e2e/demo.json

# real | demo. "demo" uses data/demo.db and allows fixture data; "real" rejects it at the database level.
APP_MODE=real
# Optional. Defaults to data/app.db (real) or data/demo.db (demo).
# DB_PATH=data/app.db

# --- Server ---
# A loopback address. Any other address is refused unless NODE_ENV=production and SESSION_SECRET are set (see
# docs/security.md); only the loopback names, HOST itself and the ALLOWED_ORIGIN host are answered (DNS rebinding).
HOST=127.0.0.1
PORT=3001
# Unset by default: no CORS headers at all. Set it only when the client is served from another origin; that origin
# may then call the API with the session cookie. An https origin also marks the cookie Secure.
# ALLOWED_ORIGIN=http://localhost:5173
# Random string of 32+ characters; signs the anonymous session cookie. Required when NODE_ENV=production; in
# development an ephemeral secret is generated (sessions then end when the process restarts).
SESSION_SECRET=
# NODE_ENV=production
# How long running turns may finish after SIGINT or SIGTERM, in milliseconds.
# SHUTDOWN_GRACE_MS=15000
# Pause between scripted sentences, in milliseconds (scripted set only).
# SCRIPTED_PACE_MS=120

# --- Quotas: what one browser can make the server spend on the provider keys (all per process) ---
# Turns one user may have running at once, across all conversations (1-50); more get 429 too_many_turns.
# MAX_RUNNING_TURNS_PER_USER=2
# New turns per user: a bucket of TURN_RATE_BURST turns refilled at TURN_RATE_PER_MINUTE (1-1000 each).
# TURN_RATE_PER_MINUTE=10
# TURN_RATE_BURST=5
# New anonymous sessions (users) per client address per hour, also the burst (1-100000).
# NEW_SESSIONS_PER_HOUR=20
# node:http limits: open connections (1-100000), and the time to receive the headers and the whole request, in
# milliseconds (1000-600000; the headers timeout must not exceed the request timeout).
# SERVER_MAX_CONNECTIONS=256
# SERVER_HEADERS_TIMEOUT_MS=20000
# SERVER_REQUEST_TIMEOUT_MS=30000

# --- Live providers (used only by APP_COMPONENTS=live) ---
# Gemini Developer API (the free tier works). GEMINI_MODEL is optional: it defaults to gemini-3.5-flash-lite.
# Free-tier prompts may be used by Google to improve its products: send only synthetic or public test data.
GEMINI_API_KEY=
GEMINI_MODEL=
# Asked once when GEMINI_MODEL is rate limited, overloaded or too slow; "none" turns it off.
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Client-side pacing of Gemini calls. The defaults (3 at a time, at most 15 starts a minute, no fixed gap) suit a
# free tier of about 15 requests a minute; with a paid key raise GEMINI_MAX_PER_MINUTE and GEMINI_MAX_CONCURRENT.
# GEMINI_MAX_CONCURRENT=3
# GEMINI_MIN_SPACING_MS=0
# GEMINI_MAX_PER_MINUTE=15
EXA_API_KEY=
# Exa searches in flight at once across all turns (1-32); no spacing between them.
# EXA_MAX_CONCURRENT=4
# Optional JSON file mapping an entity name to the registrable domains that are its own official sites, for example
# {"Example Co": ["example.com"]}. Without an entry, a domain that is exactly a company's one-word name
# (supabase.com for Supabase) is treated as official. See docs/running.md.
# OFFICIAL_DOMAINS_FILE=
