# Copy to .env and fill in. Values are validated at startup (src/config/env.ts and src/app/env.ts).
# `.env` is ignored by git. Never put real keys in this file.
# Only APP_MODE and DB_PATH matter for the database tooling and the tests; the rest is for running the application.

# --- Component set: exactly one, fixed for the life of the process; there is no automatic fallback between them ---
# scripted (default): canned demo answers, no search and no model.
# replay: the real pipeline over recorded fixtures. Needs APP_MODE=demo and REPLAY_FIXTURE.
# live: the real pipeline over Gemini and Exa. Needs APP_MODE=real, GEMINI_API_KEY, GEMINI_MODEL and EXA_API_KEY.
APP_COMPONENTS=scripted
# REPLAY_FIXTURE=tests/fixtures/e2e/demo.json

# real | demo. "demo" uses data/demo.db and allows fixture data; "real" rejects it at the database level.
APP_MODE=real
# Optional. Defaults to data/app.db (real) or data/demo.db (demo).
# DB_PATH=data/app.db

# --- Server ---
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
# Random string of 32+ characters; signs the anonymous session cookie. Required when NODE_ENV=production; in
# development an ephemeral secret is generated (sessions then end when the process restarts).
SESSION_SECRET=
# NODE_ENV=production
# How long running turns may finish after SIGINT or SIGTERM, in milliseconds.
# SHUTDOWN_GRACE_MS=15000
# Pause between scripted sentences, in milliseconds (scripted set only).
# SCRIPTED_PACE_MS=120

# --- Live providers (used only by APP_COMPONENTS=live) ---
# Gemini Developer API (the free tier works). GEMINI_MODEL is optional: it defaults to gemini-3.5-flash.
# Free-tier prompts may be used by Google to improve its products: send only synthetic or public test data.
GEMINI_API_KEY=
GEMINI_MODEL=
# Client-side pacing of Gemini calls. The defaults (1 at a time, 4000 ms apart) suit a free tier; with a paid key
# try GEMINI_MAX_CONCURRENT=4 and GEMINI_MIN_SPACING_MS=0 for much faster research turns.
# GEMINI_MAX_CONCURRENT=1
# GEMINI_MIN_SPACING_MS=4000
EXA_API_KEY=
# Optional JSON file mapping an entity name to the registrable domains that are its own official sites, for example
# {"Example Co": ["example.com"]}. Without it no domain is treated as official. See docs/running.md.
# OFFICIAL_DOMAINS_FILE=

# --- Other model settings ---
# Names used by the Anthropic adapter, which is frozen and has never been run live. Not used by the live set.
MODEL_FAST=claude-haiku-5-5
MODEL_MAIN=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Optional, only for the provider bake-off script
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
