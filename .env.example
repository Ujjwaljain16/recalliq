# Copy to .env and fill in. Values are validated at startup (src/config/env.ts).
# Only APP_MODE and DB_PATH are needed for the database tooling and the tests; the keys below are for the research pipeline.

# real | demo. "demo" uses data/demo.db and allows fixture data; "real" rejects it at the database level.
APP_MODE=real
# Optional. Defaults to data/app.db (real) or data/demo.db (demo).
# DB_PATH=data/app.db

PORT=3001
ALLOWED_ORIGIN=http://localhost:5173

# Models (behind LlmPort; swapping provider is an adapter plus these values)
MODEL_FAST=claude-haiku-5-5
MODEL_MAIN=claude-sonnet-5-5

# Required to run the research pipeline against real providers
ANTHROPIC_API_KEY=
# Gemini Developer API free tier (no paid access needed). Model id has no default: choose an eligible free-tier model.
# Free-tier prompts may be used by Google to improve its products: send only synthetic test data.
GEMINI_API_KEY=
GEMINI_MODEL=
EXA_API_KEY=
# Random string of 32+ characters; signs the anonymous user cookie
SESSION_SECRET=

# Optional, only for the provider bake-off script
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
